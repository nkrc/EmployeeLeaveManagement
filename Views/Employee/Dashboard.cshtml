@using EmployeeLeaveManagement.Models

@{
    ViewData["Title"] = "Employee Dashboard";

    var pendingLeaves =
        ViewBag.PendingLeaves as List<LeaveRequest>
        ?? new List<LeaveRequest>();

    var approvedLeaves =
        ViewBag.ApprovedLeaves as List<LeaveRequest>
        ?? new List<LeaveRequest>();

    var rejectedLeaves =
        ViewBag.RejectedLeaves as List<LeaveRequest>
        ?? new List<LeaveRequest>();
}

<div class="container mt-4">

    <h2>Employee Dashboard</h2>

    @* @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["SuccessMessage"]
        </div>
    } *@

    <div class="row g-4 mt-2">

        <!-- Total Requests -->
        <div class="col-md-3">
            <button type="button"
                    class="dashboard-card w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#allRequestsModal">

                <span class="card-title">Total Requests</span>
                <span class="card-count">
                    @ViewBag.TotalRequests
                </span>
            </button>
        </div>

        <!-- Pending Requests -->
        <div class="col-md-3">
            <button type="button"
                    class="dashboard-card w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#pendingRequestsModal">

                <span class="card-title">Pending</span>
                <span class="card-count text-warning">
                    @ViewBag.PendingRequests
                </span>
            </button>
        </div>

        <!-- Approved Requests -->
        <div class="col-md-3">
            <button type="button"
                    class="dashboard-card w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#approvedRequestsModal">

                <span class="card-title">Approved</span>
                <span class="card-count text-success">
                    @ViewBag.ApprovedRequests
                </span>
            </button>
        </div>

        <!-- Rejected Requests -->
        <div class="col-md-3">
            <button type="button"
                    class="dashboard-card w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#rejectedRequestsModal">

                <span class="card-title">Rejected</span>
                <span class="card-count text-danger">
                    @ViewBag.RejectedRequests
                </span>
            </button>
        </div>

    </div>

    <div class="mt-4">
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#applyLeaveModal">
            Apply Leave
        </button>

        <a asp-controller="Employee"
           asp-action="MyLeaves"
           class="btn btn-outline-primary">
            My Leave Requests
        </a>
    </div>
</div>


<!-- Apply Leave Modal -->
<div class="modal fade"
     id="applyLeaveModal"
     tabindex="-1"
     aria-labelledby="applyLeaveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Employee"
                  asp-action="ApplyLeave"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="applyLeaveModalLabel">
                        Apply Leave
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">From Date</label>

                        <input type="date"
                               name="FromDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">To Date</label>

                        <input type="date"
                               name="ToDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reason</label>

                        <textarea name="Reason"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter reason for leave"
                                  required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Submit Leave
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- Pending Requests Modal -->
<div class="modal fade"
     id="pendingRequestsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Pending Leave Requests</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                @if (!pendingLeaves.Any())
                {
                    <p class="text-muted">No pending requests.</p>
                }
                else
                {
                    @foreach (var leave in pendingLeaves)
                    {
                        <div class="border rounded p-3 mb-2">
                            <strong>
                                @leave.FromDate.ToString("dd MMM yyyy")
                                -
                                @leave.ToDate.ToString("dd MMM yyyy")
                            </strong>

                            <div>@leave.Reason</div>

                            <span class="badge bg-warning text-dark mt-2">
                                Pending
                            </span>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>


<!-- Approved Requests Modal -->
<div class="modal fade"
     id="approvedRequestsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Approved Leave Requests</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                @if (!approvedLeaves.Any())
                {
                    <p class="text-muted">No approved requests.</p>
                }
                else
                {
                    @foreach (var leave in approvedLeaves)
                    {
                        <div class="border rounded p-3 mb-2">
                            <strong>
                                @leave.FromDate.ToString("dd MMM yyyy")
                                -
                                @leave.ToDate.ToString("dd MMM yyyy")
                            </strong>

                            <div>@leave.Reason</div>

                            <span class="badge bg-success mt-2">
                                Approved
                            </span>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>


<!-- Rejected Requests Modal -->
<div class="modal fade"
     id="rejectedRequestsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Rejected Leave Requests</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                @if (!rejectedLeaves.Any())
                {
                    <p class="text-muted">No rejected requests.</p>
                }
                else
                {
                    @foreach (var leave in rejectedLeaves)
                    {
                        <div class="border rounded p-3 mb-2">
                            <strong>
                                @leave.FromDate.ToString("dd MMM yyyy")
                                -
                                @leave.ToDate.ToString("dd MMM yyyy")
                            </strong>

                            <div>@leave.Reason</div>

                            <span class="badge bg-danger mt-2">
                                Rejected
                            </span>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>


<!-- All Requests Modal -->
<div class="modal fade"
     id="allRequestsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">All Leave Requests</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <a asp-action="MyLeaves"
                   class="btn btn-outline-primary">
                    View Full Leave History
                </a>
            </div>

        </div>
    </div>
</div>