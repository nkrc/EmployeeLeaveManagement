@model IEnumerable<EmployeeLeaveManagement.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Leave Requests</h2>

    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#applyLeaveModal">
        Apply Leave
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No leave requests found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Reason</th>
                            <th>Applied At</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var leave in Model)
                        {
                            <tr>
                                <td>
                                    @leave.FromDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @leave.ToDate.ToString("dd MMM yyyy")
                                </td>

                                <td>@leave.Reason</td>

                                <td>
                                    @leave.AppliedAt
                                    @* .ToLocalTime()
                                    .ToString("dd MMM yyyy hh:mm tt") *@
                                </td>

                                <td>
                                    @if (leave.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (leave.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (leave.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (leave.Status == "Withdrawn")
                                    {
                                        <span class="badge bg-secondary">
                                            Withdrawn
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (leave.Status == "Pending")
                                    {
                                        <form asp-action="WithdrawLeave"
                                              asp-route-id="@leave.Id"
                                              method="post"
                                              onsubmit="return confirm('Withdraw this leave request?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Withdraw
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


<!-- Apply Leave Modal -->
<div class="modal fade"
     id="applyLeaveModal"
     tabindex="-1"
     aria-labelledby="applyLeaveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Employee"
                  asp-action="ApplyLeave"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="applyLeaveModalLabel">
                        Apply Leave
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">From Date</label>
                        <input type="date"
                               name="FromDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">To Date</label>
                        <input type="date"
                               name="ToDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea name="Reason"
                                  class="form-control"
                                  rows="4"
                                  required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Submit Leave
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>