@model EmployeeLeaveManagement.ViewModels.LeaveRequestViewModel

@{
    ViewData["Title"] = "Apply Leave";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h3 class="mb-4">Apply for Leave</h3>

                <form asp-action="ApplyLeave" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FromDate"
                                   class="form-label"></label>

                            <input asp-for="FromDate"
                                   class="form-control"
                                   type="date" />

                            <span asp-validation-for="FromDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ToDate"
                                   class="form-label"></label>

                            <input asp-for="ToDate"
                                   class="form-control"
                                   type="date" />

                            <span asp-validation-for="ToDate"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason"
                               class="form-label"></label>

                        <textarea asp-for="Reason"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter reason for leave"></textarea>

                        <span asp-validation-for="Reason"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Submit Leave Request
                        </button>

                        <a asp-action="Dashboard"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}